# Firebase Configuration (web config values are public identifiers, not secrets)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Admin account email (used only to prefill the sign-in form)
VITE_ADMIN_AUTH_EMAIL=admin@example.org

# Firebase App Check (reCAPTCHA v3 site key). Required before enforcing App Check
# for Firestore/Storage in the Firebase console.
VITE_FIREBASE_APPCHECK_SITE_KEY=your_recaptcha_v3_site_key
# Optional: local-development debug token (leave empty in production)
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Durable rate limiting for the AI endpoints (Upstash Redis REST or Vercel KV).
# Server-side only: set these as environment variables on Vercel/Cloudflare,
# never with a VITE_ prefix.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-side AI providers (never expose these with a VITE_ prefix)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Firebase Admin SDK credentials for `npm run setup:admin` only
# Either a JSON service-account blob or a path via GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=your-project-id
SETUP_ADMIN_EMAIL=admin@example.org
SETUP_ADMIN_PASSWORD=use-a-long-unique-password
